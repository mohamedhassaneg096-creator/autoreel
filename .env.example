# Reel Studio v1 Environment Configuration
# Copy to .env and fill in keys (or configure them in the Settings UI -> saved to data/settings.json)

# Server bind (defaults to 127.0.0.1:4301 for local use)
HOST="127.0.0.1"
PORT="4301"

# 1. LLM (FreeLLMAPI or any OpenAI-compatible endpoint)
LLM_BASE_URL="http://127.0.0.1:31415/v1"
LLM_API_KEY=""
LLM_MODEL="auto"

# 2. Voice TTS (ElevenLabs)
ELEVENLABS_BASE_URL="https://api.elevenlabs.io"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# 3. Word Timing for Uploaded Audio (Deepgram)
DEEPGRAM_BASE_URL="https://api.deepgram.com"
DEEPGRAM_API_KEY=""

# 4. Custom Arabic font folder (defaults to assets/fonts)
FONT_FOLDER="assets/fonts"
